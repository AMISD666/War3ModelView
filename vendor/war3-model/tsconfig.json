{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "module": "esnext",
        "target": "es5",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "noEmitOnError": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "pretty": true,
        "noEmit": true,
        "lib": [
            "DOM"
        ],
        "skipLibCheck": true
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}