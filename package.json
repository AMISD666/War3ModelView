{
  "name": "gugu-war3-model-editor",
  "version": "1.0.0",
  "author": "SX2530075955",
  "description": "gugu-war3-model-editor",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "sync:war3-model": "node scripts/sync-war3-model-vendor.mjs",
    "check:fbx-pro-gate": "node scripts/check-fbx-pro-gate.mjs",
    "check:fbx-node-mapper": "node scripts/check-fbx-node-mapper.mjs",
    "check:fbx-sequence-names": "node scripts/check-fbx-sequence-names.mjs",
    "check:fbx-geoset-compaction": "node scripts/check-fbx-geoset-compaction.mjs",
    "check:fbx-batch-merge": "node scripts/check-fbx-batch-merge.mjs",
    "check:dissolve-effect-alpha": "node scripts/check-dissolve-effect-alpha-keys.mjs",
    "check:material-alpha-keyframes": "node scripts/check-material-alpha-keyframes.mjs",
    "check:transparent-alpha-test": "node scripts/check-transparent-alpha-test.mjs",
    "check:animation-sequence-rename": "node scripts/check-animation-panel-sequence-rename.mjs",
    "check:auto-separate-layers": "node scripts/check-auto-separate-layers.mjs",
    "check:standalone-light-client": "node scripts/check-standalone-light-client.mjs",
    "dev:vite": "vite",
    "dev": "npm run dev:vite",
    "tauri": "tauri",
    "build": "vite build",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.4",
    "@types/node": "^18.19.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@webgpu/types": "^0.1.68",
    "eslint": "^8.56.0",
    "gl-matrix": "^3.4.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-http": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "antd": "^5.21.0",
    "mdx-m3-viewer": "^5.12.0",
    "react-draggable": "^4.5.0",
    "zustand": "^4.5.0"
  }
}
