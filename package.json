{
  "name": "gugu-war3-model-editor",
  "version": "1.0.0",
  "author": "SX2530075955",
  "description": "gugu-war3-model-editor",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check:architecture": "node scripts/check-architecture-guardrails.mjs",
    "check:fbx-fixtures": "node scripts/check-fbx-import-fixtures.mjs",
    "check:war3-model-vendor": "node scripts/check-war3-model-vendor.mjs",
    "check:mdx-strict-export": "node scripts/check-mdx-strict-export.mjs",
    "check:state-sync-fixtures": "node scripts/check-state-sync-fixtures.mjs",
    "check:sequence-intervals": "node scripts/check-sequence-interval-normalization.mjs",
    "check:fbx-skin-weights": "node scripts/check-fbx-classic-skin-weight-mapping.mjs",
    "check:openable-resources": "node scripts/check-openable-resource-extensions.mjs",
    "sync:war3-model": "node scripts/sync-war3-model-vendor.mjs",
    "dev:vite": "vite",
    "dev": "npm run dev:vite",
    "tauri": "tauri",
    "build": "vite build",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.4",
    "@types/node": "^18.19.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@webgpu/types": "^0.1.68",
    "eslint": "^8.56.0",
    "gl-matrix": "^3.4.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-http": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "antd": "^5.21.0",
    "mdx-m3-viewer": "^5.12.0",
    "react-draggable": "^4.5.0",
    "zustand": "^4.5.0"
  }
}
