{
  "extends": "../tsconfig.web.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./out",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": true,
    "allowImportingTsExtensions": false
  },
  "include": [
    "../src/renderer/src/application/model-save/**/*.ts",
    "../src/renderer/src/application/model-validation/**/*.ts",
    "../src/renderer/src/infrastructure/serialization/**/*.ts",
    "../src/renderer/src/types/**/*.ts",
    "../src/renderer/src/utils/modelUtils.ts",
    "../src/renderer/src/utils/pivotUtils.ts"
  ]
}